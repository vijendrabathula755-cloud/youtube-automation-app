# Application
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_PATH=./database/app.db

# APIs
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# Video Generation
VIDEO_QUALITY=1080p
VIDEO_BITRATE=5000k
VIDEO_OUTPUT_DIR=./uploads/videos
TEMP_DIR=./temp

# TTS Settings
TTS_VOICE_RATE=1.0
TTS_VOICE_PITCH=1.0

# Scheduler
SCHEDULE_TIME=09:00
VIDEOS_PER_DAY=1

# Content Settings
CONTENT_TOPICS=motivational,educational,entertainment,technology,lifestyle
VIDEO_DURATION_SHORT=60
VIDEO_DURATION_LONG=600
