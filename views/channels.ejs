<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Channels - YouTube Automation</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header class="header">
      <h1>📺 Manage Channels</h1>
      <a href="/dashboard" class="btn btn-secondary">← Back to Dashboard</a>
    </header>

    <div class="channels-list" id="channelsList">
      <div class="loading">Loading channels...</div>
    </div>

    <div class="add-channel-section">
      <h2>🔗 Connect YouTube Channel</h2>
      <form id="connectChannelForm">
        <div class="form-group">
          <label>Language</label>
          <select name="language" required>
            <option value="english">🇬🇧 English</option>
            <option value="hindi">🇮🇳 Hindi</option>
            <option value="telugu">🇮🇳 Telugu</option>
          </select>
        </div>
        <div class="form-group">
          <label>Video Format</label>
          <select name="videoFormat" required>
            <option value="long">🎬 Long Form (10+ min)</option>
            <option value="short">⚡ Shorts (< 1 min)</option>
          </select>
        </div>
        <div class="form-group">
          <label>Upload Time</label>
          <input type="time" name="uploadTime" value="09:00" required>
        </div>
        <button type="submit" class="btn btn-primary">✅ Connect Channel</button>
      </form>
    </div>
  </div>

  <script>
    const loadChannels = async () => {
      try {
        const response = await fetch('/api/channels');
        if (!response.ok) throw new Error('Failed to load channels');
        const channels = await response.json();
        const list = document.getElementById('channelsList');
        
        if (!channels || channels.length === 0) {
          list.innerHTML = '<div class="no-data">No channels connected yet</div>';
        } else {
          list.innerHTML = channels.map(ch => `
            <div class="channel-item">
              <img src="${ch.channelImage || '/images/default-channel.png'}" alt="${ch.channelName}" onerror="this.src='/images/default-channel.png'">
              <div class="channel-info">
                <h3>${ch.channelName}</h3>
                <p>🌍 Language: ${ch.language}</p>
                <p>📹 Format: ${ch.videoFormat}</p>
                <p>⏰ Upload Time: ${ch.uploadTime}</p>
              </div>
              <button onclick="deleteChannel('${ch.id}')" class="btn btn-danger">🗑️ Delete</button>
            </div>
          `).join('');
        }
      } catch (error) {
        document.getElementById('channelsList').innerHTML = `<div class="error">Error: ${error.message}</div>`;
      }
    };

    const deleteChannel = async (channelId) => {
      if (!confirm('Are you sure you want to delete this channel?')) return;
      try {
        const response = await fetch(`/api/channels/${channelId}`, { method: 'DELETE' });
        if (response.ok) {
          alert('✅ Channel deleted');
          loadChannels();
        } else {
          alert('❌ Error deleting channel');
        }
      } catch (error) {
        alert('❌ Error: ' + error.message);
      }
    };

    document.getElementById('connectChannelForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      try {
        const response = await fetch('/api/channels/connect', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(formData))
        });
        const data = await response.json();
        if (response.ok) {
          alert('✅ Channel connected: ' + data.channel.channelName);
          loadChannels();
          e.target.reset();
        } else {
          alert('❌ Error: ' + (data.error || 'Unknown error'));
        }
      } catch (error) {
        alert('❌ Error: ' + error.message);
      }
    });

    loadChannels();
  </script>
</body>
</html>
