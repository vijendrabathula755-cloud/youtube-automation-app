<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>YouTube Automation App</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header class="header">
      <h1>🎬 YouTube Automation App</h1>
      <p>Create, Generate & Upload Videos Automatically</p>
    </header>

    <% if (user) { %>
      <div class="user-info">
        <img src="<%= user.photo %>" alt="Profile">
        <span><%= user.name %></span>
        <a href="/auth/logout">Logout</a>
      </div>
      <nav class="nav">
        <a href="/dashboard">📊 Dashboard</a>
        <a href="/channels">📺 Channels</a>
        <a href="/settings">⚙️ Settings</a>
      </nav>
      
      <div class="welcome-section">
        <h2>Welcome to YouTube Automation! 🎉</h2>
        <p>Ready to automate your YouTube channel?</p>
        <div class="quick-actions">
          <a href="/channels" class="btn btn-primary">➕ Connect Your Channel</a>
          <a href="/dashboard" class="btn btn-secondary">📊 View Dashboard</a>
        </div>
      </div>
    <% } else { %>
      <div class="login-section">
        <h2>Welcome to YouTube Automation</h2>
        <p>Automate your YouTube channel with AI-powered video generation</p>
        <a href="/auth/google" class="btn btn-primary">Login with Google</a>
      </div>
    <% } %>
  </div>
</body>
</html>
